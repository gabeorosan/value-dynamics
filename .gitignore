# envs / caches
.venv/
__pycache__/
*.pyc
.DS_Store

# node (slide rendering)
node_modules/

# run artifacts (regenerable)
data/
runs/
runs_*/
results/
results*.json
*.zip
outputs/

# Kaggle pulls can include regenerated adapters and noisy runtime logs.
# Keep scripts, metadata, and compact JSON summaries in git instead.
experiments/kaggle/kaggle_*/output/**/*.safetensors
experiments/kaggle/kaggle_*/output/**/adapter_config.json
experiments/kaggle/kaggle_*/output/**/README.md
experiments/kaggle/kaggle_*/output/*.log
experiments/kaggle/kaggle_*/output/**/value-perpetuation.log

# Local scratch created during agent/Colab/Kaggle exploration.
/claude-session-*/
/kaggle_*/
/kaggle_dataset/
/colab_*.py
/Technical_AI_Safety_Project_Log.docx

.trigger*.svg.png
__pycache__/

# Agent/tooling state, not research artifacts
/.agents/
/.codex/
/AGENTS.md
/scratchpad/
/specs/

# Demo renders. The published cut lives in site/media/; everything in demo/
# is a local build artifact regenerable from demo/src/scenes_*.json.
demo/*.mp4
demo/*.srt
demo/*_poster.png
demo/thread_images/
/experiments/cerebrium/
/scripts/cerebrium_smoke.sh

# Superseded demo sources, kept on disk but out of the tree: these cuts predate
# the current writeup and carry claims it no longer makes.
demo/poster.png
demo/WRITEUP_DEMO_SCRIPT.md
demo/RESEARCH_VISION_DEMO_SCRIPT.md
demo/src/scenes_writeup.json
demo/src/scenes_vision.json

# Local archive of retired scaffolding (Trigger.dev), kept off the tree
/.archive-local/

# Adapter weights from any experiment output are large and reproducible; never commit.
experiments/**/output/**/*.safetensors
experiments/**/output/**/spread_ckpt/
experiments/**/output/**/*_adapter/

# Kaggle run outputs live in output*/ dirs, not just output/. Adapter weights
# are large (695MB in one oracle run) and are never needed in git.
experiments/**/output*/**/*.safetensors
experiments/**/output*/**/*.bin
experiments/**/*_ckpt/
experiments/**/*_start_adapter/
